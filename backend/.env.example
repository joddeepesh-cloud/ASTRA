# ASTRA Backend & Space Help AI Environment Configuration

# Frontend Origins (CORS)
FRONTEND_ORIGIN=http://localhost:5173

# ASTRA Space Help AI Configuration
# Provider options: google | openai | local
ASTRA_AI_PROVIDER=google

# Target LLM Model Name (e.g., gemini-1.5-flash, gpt-4o-mini)
ASTRA_AI_MODEL=gemini-1.5-flash

# Secret API Key (Keep empty for offline/grounded reasoning fallback)
ASTRA_AI_API_KEY=
