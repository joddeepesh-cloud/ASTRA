# ML Datasets (Ignore raw/processed/splits content except .gitkeep)
ml/data/raw/*
!ml/data/raw/.gitkeep
ml/data/processed/*
!ml/data/processed/.gitkeep
ml/data/splits/*
!ml/data/splits/.gitkeep
*.fits
*.fits.fz
*.h5
*.hdf5
*.tar
*.tar.gz
*.zip

# ML Model Checkpoints & Large Artifacts
ml/models/*
!ml/models/.gitkeep
*.pth
*.pt
*.bin
*.onnx
*.safetensors
*.ckpt

# Generated Embeddings & Artifacts
ml/artifacts/*
!ml/artifacts/.gitkeep
*.pkl
*.joblib
*.npz
*.npy

# Environment Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.key
*.pem
secrets/

# IDE & Editors
.vscode/
.idea/
*.swp
*.swo
